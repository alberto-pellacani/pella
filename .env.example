# Copia questo file in .env e inserisci i valori (il file .env NON va su Git)

# Neon: URL "pooled" (host con -pooler) usato dall'app
DATABASE_URL=
# Neon: URL "direct" (host senza -pooler) usato per le migrazioni
DIRECT_URL=

# Stringa casuale lunga, es. generata con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Chiave (64 caratteri esadecimali) per cifrare nel database le chiavi API dei provider AI.
# Generala con lo stesso comando di SESSION_SECRET. NON cambiarla dopo aver salvato le chiavi:
# quelle già salvate diventerebbero illeggibili e andrebbero reinserite.
AI_ENCRYPTION_KEY=

# Google Cloud Console > Credenziali > OAuth client ID (lasciare vuoti per disattivare Google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Indirizzo pubblico dell'app (in locale http://localhost:3000)
BASE_URL=http://localhost:3000
PORT=3000
NODE_ENV=development
