<%- include('partials/header') %>
<section class="card narrow">
  <h1>Registrati</h1>
  <form method="post" action="/register">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <label>Nome visualizzato <input type="text" name="displayName" maxlength="100" autocomplete="name" placeholder="facoltativo"></label>
    <label>Email <input type="email" name="email" required autocomplete="email"></label>
    <label>Password <input type="password" name="password" required minlength="8" autocomplete="new-password">
      <small class="muted">Almeno 8 caratteri</small></label>
    <button type="submit" class="button">Crea account</button>
  </form>
  <%- include('partials/google') %>
  <p class="muted">Hai già un account? <a href="/login">Accedi</a></p>
</section>
<%- include('partials/footer') %>
