  </main>
<% if (locals.currentUser) {
  const p = locals.currentPath || '';
  const tab = (href, label, icon, active) =>
    `<a class="tab${active ? ' active' : ''}" href="${href}">` + include('icon', { name: icon }) + `<span>${label}</span></a>`;
%>
  <nav class="bottombar" aria-label="Navigazione rapida">
    <%- tab('/', 'Home', 'home', p === '/') %>
    <%- tab('/profile', 'Profilo', 'user', p === '/profile') %>
    <%- tab('#menu', 'Menu', 'menu', p !== '/' && p !== '/profile') %>
  </nav>
<% } %>
  <script src="/app.js" defer></script>
</body>
</html>
