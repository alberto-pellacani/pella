<!doctype html>
<html lang="it">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title><%= locals.title ? title + ' · ' : '' %>Pella App</title>
  <link rel="stylesheet" href="/style.css">
</head>
<% if (locals.currentUser) { %>
<body class="app">
  <header class="topbar">
    <a class="brand" href="/">PELLA</a>
    <span class="who"><%= currentUser.displayName %> · <%= currentUser.role %></span>
  </header>
  <aside class="sidebar">
    <%- include('nav', { variant: 'sidebar' }) %>
  </aside>
  <div id="menu" class="menu-full" role="dialog" aria-label="Menu">
    <div class="menu-head">
      <span class="brand">Menu</span>
      <a href="#" class="icon-btn" aria-label="Chiudi menu"><%- include('icon', { name: 'x' }) %></a>
    </div>
    <%- include('nav', { variant: 'fullscreen' }) %>
  </div>
  <main class="content">
<% } else { %>
<body class="guest">
  <main class="auth">
    <div class="auth-brand">PELLA</div>
<% } %>
    <% if (locals.flash) { %>
      <div class="flash <%= flash.type %>" role="status">
        <%- include('icon', { name: flash.type === 'error' ? 'alert' : 'check' }) %><span><%= flash.text %></span>
      </div>
    <% } %>
